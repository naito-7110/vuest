{
  "name": "vuest",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "playground:dev": "turbo --filter playground dev",
    "test:unit": "vitest --project unit --watch=false",
    "fmt": "oxfmt -c oxfmt.config.ts packages/**/*.{ts,vue,tsx,json,tsx,md,mdx}",
    "fmt:check": "oxfmt --check oxfmt.config.ts packages/**/*.{ts,vue,tsx,json,tsx,md,mdx}",
    "lint": "oxlint -c oxlint.config.ts --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/typescript-plugin": "^3.2.7",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "turbo": "^2.9.6",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2"
}
